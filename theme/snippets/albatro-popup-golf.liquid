{% comment %}
  ALBATRO — Popup "El Putt Albatro" v3 (golfista animado + perspectiva + email + FUNDADOR15)
  -------------------------------------------------------------------------------------------
  · Aparece a los 15 s de navegación acumulada · 1 sola vez por usuario (localStorage "albGolf")
  · v3: GOLFISTA que ejecuta el tiro (backswing proporcional a la potencia, impacto sincronizado),
    green en perspectiva, break/caída, estela, sonido WebAudio, háptica, screen-shake,
    física por tiempo real (independiente del framerate), tarjeta adaptada a pantallas bajas.
  · Emboque o no, pide el email (form customer, tags popup-golf) y entrega FUNDADOR15.
  · Probar manualmente: añadir ?alb_golf=test a la URL.
  · Resetear usuario:   localStorage.removeItem('albGolf')
{% endcomment %}

<div id="alb-golf-popup" aria-hidden="true">
  <div class="agp-backdrop" data-agp-close></div>
  <div class="agp-card" role="dialog" aria-modal="true" aria-label="El Putt Albatro — juega y gana 15% de descuento">
    <button type="button" class="agp-close" data-agp-close aria-label="Cerrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <!-- VISTA 1 · JUEGO -->
    <div class="agp-view agp-view-game">
      <div class="agp-head">
        <span class="agp-eyebrow">El putt Albatro</span>
        <h3 class="agp-title">Emboca el putt y gana <em>15%</em></h3>
        <p class="agp-sub">Arrastra desde la pelota, apunta y suelta.</p>
      </div>
      <div class="agp-canvas-wrap">
        <canvas id="agp-canvas" width="320" height="460"></canvas>
      </div>
      <div class="agp-footrow">
        <span class="agp-msg" id="agp-msg">Intento 1 de 3</span>
        <span class="agp-tries" id="agp-tries" aria-label="Intentos restantes"><i></i><i></i><i></i></span>
      </div>
    </div>

    <!-- VISTA 2 · EMAIL -->
    <div class="agp-view agp-view-email" hidden>
      <div class="agp-head">
        <span class="agp-eyebrow">El putt Albatro</span>
        <h3 class="agp-title" id="agp-result-title">¡Putt perfecto!</h3>
        <p class="agp-sub" id="agp-result-sub">Deja tu correo y desbloquea tu 15% de descuento.</p>
      </div>
      {% form 'customer', class: 'agp-form' %}
        {% if form.errors %}
          <p class="agp-err">Revisa tu correo e inténtalo de nuevo.</p>
        {% endif %}
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <input type="hidden" name="contact[tags]" value="popup-golf,lista-espera">
        <input type="hidden" name="return_to" value="/?alb_golf=ok">
        <div class="agp-field">
          <input type="email" name="contact[email]" placeholder="tu@email.com" autocomplete="email" required>
          <button type="submit" class="agp-btn">Desbloquear mi 15%</button>
        </div>
        <p class="agp-fine">Sin spam, solo golf. Te puedes dar de baja cuando quieras.</p>
      {% endform %}
    </div>

    <!-- VISTA 3 · CÓDIGO -->
    <div class="agp-view agp-view-code" hidden>
      <div class="agp-head">
        <span class="agp-eyebrow">Tu premio</span>
        <h3 class="agp-title">15% en tu compra</h3>
        <p class="agp-sub">Usa este código en el checkout:</p>
      </div>
      <div class="agp-codebox">
        <span class="agp-code" id="agp-code">FUNDADOR15</span>
        <button type="button" class="agp-copy" id="agp-copy">Copiar</button>
      </div>
      <p class="agp-fine">Un uso por cliente · Válido en toda la tienda.</p>
      <button type="button" class="agp-btn agp-btn-full" data-agp-close>Seguir comprando</button>
    </div>
  </div>
</div>

<style>
#alb-golf-popup{position:fixed;inset:0;z-index:99999;display:none;align-items:center;justify-content:center;padding:14px;}
#alb-golf-popup.is-open{display:flex;}
#alb-golf-popup .agp-backdrop{position:absolute;inset:0;background:rgba(8,18,12,.58);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);opacity:0;transition:opacity .3s ease;}
#alb-golf-popup.is-in .agp-backdrop{opacity:1;}
.agp-card{position:relative;width:min(92vw,380px);max-height:94vh;overflow:auto;background:#F8F6F1;border-radius:18px;padding:20px 20px 18px;box-shadow:0 30px 80px rgba(0,0,0,.45);transform:translateY(12px) scale(.95);opacity:0;transition:transform .35s cubic-bezier(.21,1.02,.55,1.01),opacity .25s ease;}
#alb-golf-popup.is-in .agp-card{transform:translateY(0) scale(1);opacity:1;}
.agp-close{position:absolute;top:12px;right:12px;width:32px;height:32px;border-radius:50%;border:1px solid rgba(16,38,24,.18);background:rgba(255,255,255,.7);color:#102618;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:3;transition:background .2s;}
.agp-close:hover{background:#fff;}
.agp-close svg{width:14px;height:14px;}
.agp-head{text-align:center;margin-bottom:10px;}
.agp-eyebrow{display:block;font:700 10px/1 'Inter',system-ui,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#C9A84C;margin-bottom:6px;}
.agp-title{margin:0 0 4px;font:italic 700 24px/1.12 Georgia,'Times New Roman',serif;color:#102618;}
.agp-title em{font-style:italic;color:#C9A84C;}
.agp-sub{margin:0;font:400 12.5px/1.45 'Inter',system-ui,sans-serif;color:rgba(16,38,24,.72);}
.agp-canvas-wrap{display:flex;justify-content:center;}
#agp-canvas{display:block;width:min(100%,calc((94vh - 215px) * 0.6957));height:auto;touch-action:none;cursor:crosshair;border-radius:14px;box-shadow:inset 0 0 0 1px rgba(16,38,24,.08);}
.agp-footrow{display:flex;align-items:center;justify-content:space-between;margin-top:8px;}
.agp-msg{font:600 12px/1 'Inter',system-ui,sans-serif;color:rgba(16,38,24,.65);}
.agp-tries{display:flex;gap:6px;}
.agp-tries i{width:10px;height:10px;border-radius:50%;background:#fff;border:1.5px solid #C9A84C;box-shadow:inset -1px -1px 2px rgba(0,0,0,.15);transition:opacity .3s;}
.agp-tries i.used{opacity:.22;}
.agp-form{margin:0;}
.agp-field{display:flex;flex-direction:column;gap:10px;}
.agp-field input[type="email"]{width:100%;box-sizing:border-box;padding:13px 14px;border-radius:10px;border:1px solid rgba(16,38,24,.22);background:#fff;font:400 14px/1 'Inter',system-ui,sans-serif;color:#102618;outline:none;transition:border .2s;}
.agp-field input[type="email"]:focus{border-color:#C9A84C;}
.agp-btn{display:block;width:100%;padding:14px;border:0;border-radius:10px;background:#102618;color:#F8F6F1;font:700 14px/1 'Inter',system-ui,sans-serif;letter-spacing:.02em;cursor:pointer;transition:background .2s,transform .15s;}
.agp-btn:hover{background:#1A3D2E;transform:translateY(-1px);}
.agp-btn-full{margin-top:14px;}
.agp-fine{margin:10px 0 0;text-align:center;font:400 11px/1.4 'Inter',system-ui,sans-serif;color:rgba(16,38,24,.5);}
.agp-err{margin:0 0 10px;text-align:center;font:600 12px/1.4 'Inter',system-ui,sans-serif;color:#a33;}
.agp-codebox{display:flex;align-items:center;justify-content:space-between;gap:10px;border:2px dashed #C9A84C;border-radius:12px;padding:14px 16px;background:#fff;}
.agp-code{font:700 22px/1 'Courier New',monospace;letter-spacing:.08em;color:#102618;}
.agp-copy{flex:0 0 auto;padding:9px 14px;border-radius:8px;border:1px solid rgba(16,38,24,.25);background:#F8F6F1;font:700 12px/1 'Inter',system-ui,sans-serif;color:#102618;cursor:pointer;transition:background .2s;}
.agp-copy:hover{background:#efece4;}
@media (max-width:480px){
  .agp-card{padding:18px 14px 14px;}
  .agp-title{font-size:21px;}
}
@media (prefers-reduced-motion: reduce){
  #alb-golf-popup .agp-backdrop,.agp-card{transition:none;}
}
</style>

<script>
(function(){
  'use strict';
  var LS='albGolf';
  function lsGet(){try{return JSON.parse(localStorage.getItem(LS)||'{}');}catch(e){return {};}}
  function lsSet(o){try{localStorage.setItem(LS,JSON.stringify(o));}catch(e){}}

  var root=document.getElementById('alb-golf-popup');
  if(!root) return;
  var views={game:root.querySelector('.agp-view-game'),email:root.querySelector('.agp-view-email'),code:root.querySelector('.agp-view-code')};
  var state=lsGet();
  var isTest=/alb_golf=test/.test(location.search);
  var gameStarted=false;

  function showView(name){
    for(var k in views){ if(views[k]) views[k].hidden=(k!==name); }
  }
  function openPopup(){
    root.classList.add('is-open');
    root.setAttribute('aria-hidden','false');
    requestAnimationFrame(function(){ root.classList.add('is-in'); });
    setTimeout(function(){
      var c=root.querySelector('.agp-card'), b=root.querySelector('.agp-backdrop');
      if(c){ c.style.opacity='1'; c.style.transform='none'; }
      if(b){ b.style.opacity='1'; }
    },650);
    if(!views.game.hidden && !gameStarted){ gameStarted=true; initGame(); }
  }
  function closePopup(){
    root.classList.remove('is-in');
    var c=root.querySelector('.agp-card'), b=root.querySelector('.agp-backdrop');
    if(c){ c.style.opacity=''; c.style.transform=''; }
    if(b){ b.style.opacity=''; }
    setTimeout(function(){ root.classList.remove('is-open'); root.setAttribute('aria-hidden','true'); },260);
  }
  root.addEventListener('click',function(e){ if(e.target.closest('[data-agp-close]')) closePopup(); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&root.classList.contains('is-open')) closePopup(); });

  var copyBtn=document.getElementById('agp-copy');
  if(copyBtn) copyBtn.addEventListener('click',function(){
    var code=document.getElementById('agp-code').textContent.trim();
    function ok(){ copyBtn.textContent='Copiado ✓'; setTimeout(function(){copyBtn.textContent='Copiar';},1800); }
    if(navigator.clipboard&&navigator.clipboard.writeText){ navigator.clipboard.writeText(code).then(ok); }
    else{ var t=document.createElement('textarea'); t.value=code; document.body.appendChild(t); t.select(); try{document.execCommand('copy');ok();}catch(e){} document.body.removeChild(t); }
  });

  if(/alb_golf=ok/.test(location.search)){
    state.done=1; lsSet(state);
    showView('code'); openPopup();
    try{ history.replaceState(null,'',location.pathname); }catch(e){}
    return;
  }

  if((state.done||state.shown)&&!isTest) return;

  if(!state.first){ state.first=Date.now(); lsSet(state); }
  var elapsed=Date.now()-state.first;
  var waitMs=isTest?400:Math.max(15000-elapsed,800);
  setTimeout(function(){
    state.shown=1; lsSet(state);
    showView('game'); openPopup();
  },waitMs);

  function initGame(){
    var canvas=document.getElementById('agp-canvas');
    if(!canvas) return;
    var W=320,H=460;
    var dpr=Math.min(window.devicePixelRatio||1,2);
    canvas.width=W*dpr; canvas.height=H*dpr;
    var ctx=canvas.getContext('2d');
    ctx.scale(dpr,dpr);

    var SKY=64;
    var GX=14,GY=SKY,GW=W-28,GH=H-SKY-12;
    var CX=W/2;
    var hole={x:CX,y:GY+78,r:13};
    var start={x:CX-14,y:GY+322};
    var ball={x:start.x,y:start.y,r:9,vx:0,vy:0,scale:1,moving:false,sinking:false,roll:0};
    var tries=3,finished=false,lipped=false,hasPutted=false;
    var aiming=false,aimX=0,aimY=0;
    var t=0,particles=[],grassFlecks=[],trail=[],shake=0,minDist=1e9,endY=0;
    var swing={phase:'idle',a:0,fired:true};
    var pending=null;
    var breakDir=Math.random()<0.5?-1:1;
    var reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var introT=0, introDur=reduced?1:34;
    var msgEl=document.getElementById('agp-msg');
    var triesEl=document.getElementById('agp-tries');

    function ps(y){ var k=(y-GY)/GH; if(k<0)k=0; if(k>1)k=1; return 0.60+0.40*k; }
    function tx(x,y){ return CX+(x-CX)*ps(y); }
    function power(){ return Math.min(Math.hypot(ball.x-aimX,ball.y-aimY),130)/130; }

    var AC=null;
    function audio(){ if(AC)return AC; try{AC=new (window.AudioContext||window.webkitAudioContext)();}catch(e){} return AC; }
    function tone(f0,f1,dur,type,vol,delay){
      var a=audio(); if(!a)return;
      try{
        var t0=a.currentTime+(delay||0);
        var o=a.createOscillator(),g=a.createGain();
        o.type=type||'sine';
        o.frequency.setValueAtTime(f0,t0);
        if(f1) o.frequency.exponentialRampToValueAtTime(f1,t0+dur);
        g.gain.setValueAtTime(vol||0.12,t0);
        g.gain.exponentialRampToValueAtTime(0.0001,t0+dur);
        o.connect(g); g.connect(a.destination);
        o.start(t0); o.stop(t0+dur+0.02);
      }catch(e){}
    }
    function sndPutt(){ tone(170,90,0.09,'sine',0.20); tone(1100,700,0.03,'square',0.05); }
    function sndBounce(){ tone(130,85,0.06,'sine',0.10); }
    function sndSink(){ tone(330,150,0.18,'sine',0.22); tone(880,1320,0.18,'triangle',0.08,0.10); tone(1100,1760,0.22,'triangle',0.06,0.22); }
    function buzz(p){ try{ if(navigator.vibrate) navigator.vibrate(p); }catch(e){} }

    function drawSky(){
      var g=ctx.createLinearGradient(0,0,0,SKY+10);
      g.addColorStop(0,'#EFE9D7'); g.addColorStop(1,'#DCE4CE');
      ctx.fillStyle=g; ctx.fillRect(0,0,W,SKY+10);
      var s=ctx.createRadialGradient(252,14,2,252,14,44);
      s.addColorStop(0,'rgba(201,168,76,.55)'); s.addColorStop(1,'rgba(201,168,76,0)');
      ctx.fillStyle=s; ctx.fillRect(188,0,128,66);
      ctx.strokeStyle='rgba(16,38,24,.4)'; ctx.lineWidth=1.1; ctx.lineCap='round';
      [[64,20],[86,28]].forEach(function(b){
        ctx.beginPath(); ctx.moveTo(b[0]-5,b[1]); ctx.quadraticCurveTo(b[0]-2,b[1]-3.5,b[0],b[1]);
        ctx.quadraticCurveTo(b[0]+2,b[1]-3.5,b[0]+5,b[1]); ctx.stroke();
      });
      ctx.fillStyle='#123018';
      ctx.beginPath(); ctx.moveTo(0,SKY+5);
      var bumps=[[12,15],[36,22],[62,13],[92,24],[124,11],[156,20],[188,14],[220,23],[250,12],[280,19],[320,15]];
      for(var i=0;i<bumps.length;i++){
        ctx.quadraticCurveTo(bumps[i][0]-11,SKY+5-bumps[i][1],bumps[i][0],SKY+5-bumps[i][1]*0.45);
        ctx.quadraticCurveTo(bumps[i][0]+9,SKY+5-bumps[i][1]*0.15,Math.min(bumps[i][0]+20,W),SKY+5);
      }
      ctx.lineTo(W,SKY+10); ctx.lineTo(0,SKY+10); ctx.closePath(); ctx.fill();
    }

    function greenPath(pad){
      var p=pad||0;
      var bl=GX-p, br=GX+GW+p, bot=GY+GH+p, top=GY-p*0.4;
      ctx.beginPath();
      ctx.moveTo(bl,bot);
      ctx.lineTo(tx(bl,top),top);
      ctx.lineTo(tx(br,top),top);
      ctx.lineTo(br,bot);
      ctx.closePath();
    }

    function drawGreen(){
      greenPath(7); ctx.fillStyle='#0A1A10'; ctx.fill();
      greenPath(0);
      var g=ctx.createLinearGradient(0,GY,0,GY+GH);
      g.addColorStop(0,'#2F7C4C'); g.addColorStop(.55,'#256A40'); g.addColorStop(1,'#173D25');
      ctx.fillStyle=g; ctx.fill();
      ctx.save(); greenPath(0); ctx.clip();
      for(var i=0;i<9;i++){
        var xa=GX+i*GW/9, xb=xa+GW/9;
        ctx.beginPath();
        ctx.moveTo(xa,GY+GH); ctx.lineTo(xb,GY+GH);
        ctx.lineTo(tx(xb,GY),GY); ctx.lineTo(tx(xa,GY),GY);
        ctx.closePath();
        ctx.fillStyle = (i%2===0) ? 'rgba(255,255,255,.045)' : 'rgba(0,0,0,.05)';
        ctx.fill();
      }
      var lg=ctx.createLinearGradient(GX+GW,GY,GX,GY+GH);
      lg.addColorStop(0,'rgba(255,244,214,.10)'); lg.addColorStop(.5,'rgba(255,244,214,0)'); lg.addColorStop(1,'rgba(0,0,0,.06)');
      ctx.fillStyle=lg; ctx.fillRect(GX-10,GY-10,GW+20,GH+20);
      var by=GY+150,bs=ps(by);
      ctx.beginPath(); ctx.ellipse(tx(52,by),by,27*bs,9.5*bs,-0.12,0,7);
      ctx.fillStyle='#E2D2A6'; ctx.fill();
      ctx.beginPath(); ctx.ellipse(tx(52,by)-2,by-2,23*bs,7.5*bs,-0.12,0,7);
      ctx.fillStyle='#F0E4C4'; ctx.fill();
      ctx.beginPath(); ctx.ellipse(tx(52,by)-2,by-2,23*bs,7.5*bs,-0.12,Math.PI*0.9,Math.PI*1.95);
      ctx.strokeStyle='rgba(16,38,24,.15)'; ctx.lineWidth=1; ctx.stroke();
      var vg=ctx.createRadialGradient(CX,GY+GH*0.5,90,CX,GY+GH*0.5,300);
      vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1,'rgba(0,0,0,.32)');
      ctx.fillStyle=vg; ctx.fillRect(0,GY,W,GH);
      ctx.restore();
    }

    function drawBreak(){
      var s=ps(hole.y), bx=tx(hole.x,hole.y)+(34*s)*breakDir, by=hole.y+2;
      var pulse=reduced?0.7:0.55+Math.sin(t*0.07)*0.25;
      ctx.save(); ctx.globalAlpha=pulse;
      ctx.strokeStyle='#E8D9A8'; ctx.lineWidth=2; ctx.lineCap='round'; ctx.lineJoin='round';
      ctx.beginPath();
      ctx.moveTo(bx-7*breakDir,by); ctx.lineTo(bx+5*breakDir,by);
      ctx.moveTo(bx+1*breakDir,by-4); ctx.lineTo(bx+5*breakDir,by); ctx.lineTo(bx+1*breakDir,by+4);
      ctx.stroke();
      ctx.font='700 8px Inter,system-ui,sans-serif';
      ctx.fillStyle='#E8D9A8'; ctx.textAlign='center';
      ctx.fillText('CAÍDA',bx-1*breakDir,by+14);
      ctx.restore();
    }

    function drawHole(){
      var s=ps(hole.y), hx=tx(hole.x,hole.y), hy=hole.y;
      var rx=hole.r*s, ry=hole.r*s*0.48;
      ctx.beginPath(); ctx.ellipse(hx,hy+1.5,rx+3,ry+2.4,0,0,7);
      ctx.fillStyle='rgba(0,0,0,.34)'; ctx.fill();
      var hg=ctx.createRadialGradient(hx,hy-2,1.5,hx,hy,rx);
      hg.addColorStop(0,'#000'); hg.addColorStop(1,'#0A1810');
      ctx.beginPath(); ctx.ellipse(hx,hy,rx,ry,0,0,7);
      ctx.fillStyle=hg; ctx.fill();
      ctx.beginPath(); ctx.ellipse(hx,hy,rx,ry,0,Math.PI*1.05,Math.PI*1.95);
      ctx.strokeStyle='rgba(255,255,255,.22)'; ctx.lineWidth=1.3; ctx.stroke();
    }

    function drawFlag(){
      var s=ps(hole.y), hx=tx(hole.x,hole.y), top=hole.y-58*s;
      var wave=reduced?0:Math.sin(t*0.06)*3;
      ctx.beginPath(); ctx.moveTo(hx+2,hole.y-1); ctx.lineTo(hx+9*s+3,hole.y+3);
      ctx.strokeStyle='rgba(0,0,0,.2)'; ctx.lineWidth=2; ctx.stroke();
      ctx.beginPath(); ctx.moveTo(hx,hole.y-1); ctx.lineTo(hx,top);
      var pg=ctx.createLinearGradient(hx-1,top,hx+1,hole.y);
      pg.addColorStop(0,'#fff'); pg.addColorStop(1,'#CFC9BA');
      ctx.strokeStyle=pg; ctx.lineWidth=2.3*s; ctx.lineCap='round'; ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(hx+1,top);
      ctx.quadraticCurveTo(hx+15*s,top+3+wave*0.4,hx+(26+wave)*s,top+6.5*s);
      ctx.quadraticCurveTo(hx+15*s,top+10+wave*0.4,hx+1,top+14*s);
      ctx.closePath();
      var fg=ctx.createLinearGradient(hx,top,hx+26*s,top+8*s);
      fg.addColorStop(0,'#D9B25E'); fg.addColorStop(1,'#B08A34');
      ctx.fillStyle=fg; ctx.fill();
      ctx.strokeStyle='rgba(0,0,0,.15)'; ctx.lineWidth=.8; ctx.stroke();
    }

    function drawGolfer(){
      var s=ps(start.y);
      var bx=tx(start.x,start.y);
      var fx=bx+28*s, fy=start.y+3;
      var hgt=64*s;
      var hipX=fx-2*s, hipY=fy-hgt*0.46;
      var shX=fx-9*s,  shY=fy-hgt*0.75;
      var hdX=fx-11*s, hdY=fy-hgt*0.90, hdR=hgt*0.11;

      var a=0;
      if(aiming) a=-power()*1.05;
      else if(swing.phase==='strike'||swing.phase==='follow') a=swing.a;
      else if(!reduced) a=Math.sin(t*0.03)*0.03;

      var baseA=Math.atan2(start.y-shY,bx-shX);
      var R=Math.hypot(start.y-shY,bx-shX)*1.0;
      var ca=baseA+a;
      var gripX=shX+Math.cos(ca)*R*0.42, gripY=shY+Math.sin(ca)*R*0.42;
      var headX=shX+Math.cos(ca)*R,      headY=shY+Math.sin(ca)*R;

      ctx.beginPath(); ctx.ellipse(fx-4*s,fy+2,18*s,5*s,0,0,7);
      ctx.fillStyle='rgba(0,0,0,.10)'; ctx.fill();
      ctx.beginPath(); ctx.ellipse(fx-4*s,fy+2,13*s,3.4*s,0,0,7);
      ctx.fillStyle='rgba(0,0,0,.16)'; ctx.fill();

      ctx.lineCap='round'; ctx.lineJoin='round';
      ctx.strokeStyle='#2B4A3A'; ctx.lineWidth=6.6*s;
      ctx.beginPath(); ctx.moveTo(hipX,hipY); ctx.lineTo(fx-8*s,fy); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(hipX,hipY); ctx.lineTo(fx+6*s,fy); ctx.stroke();
      ctx.strokeStyle='rgba(255,255,255,.10)'; ctx.lineWidth=1.6*s;
      ctx.beginPath(); ctx.moveTo(hipX,hipY); ctx.lineTo(fx-8*s,fy); ctx.stroke();

      ctx.fillStyle='#12241a';
      ctx.beginPath(); ctx.ellipse(fx-8*s,fy+1,6*s,2.6*s,0.15,0,7); ctx.fill();
      ctx.beginPath(); ctx.ellipse(fx+6*s,fy+1,6*s,2.6*s,-0.1,0,7); ctx.fill();

      ctx.strokeStyle='#F3EFE3'; ctx.lineWidth=7.6*s;
      ctx.beginPath(); ctx.moveTo(hipX,hipY); ctx.lineTo(shX,shY); ctx.stroke();
      ctx.strokeStyle='rgba(16,38,24,.14)'; ctx.lineWidth=2.2*s;
      ctx.beginPath(); ctx.moveTo(hipX,hipY); ctx.lineTo(shX,shY); ctx.stroke();

      ctx.strokeStyle='#F3EFE3'; ctx.lineWidth=4.2*s;
      ctx.beginPath(); ctx.moveTo(shX,shY-1*s); ctx.lineTo(gripX,gripY); ctx.stroke();
      ctx.strokeStyle='#E3B48C'; ctx.lineWidth=2.4*s;
      ctx.beginPath(); ctx.moveTo(shX+(gripX-shX)*0.55,shY+(gripY-shY)*0.55); ctx.lineTo(gripX,gripY); ctx.stroke();

      ctx.strokeStyle='#D9D5C9'; ctx.lineWidth=2*s;
      ctx.beginPath(); ctx.moveTo(gripX,gripY); ctx.lineTo(headX,headY); ctx.stroke();
      var pa=ca+Math.PI/2;
      ctx.strokeStyle='#8A857A'; ctx.lineWidth=4.2*s;
      ctx.beginPath();
      ctx.moveTo(headX-Math.cos(pa)*4*s,headY-Math.sin(pa)*4*s);
      ctx.lineTo(headX+Math.cos(pa)*4*s,headY+Math.sin(pa)*4*s);
      ctx.stroke();
      ctx.strokeStyle='#C9A84C'; ctx.lineWidth=1*s;
      ctx.beginPath();
      ctx.moveTo(headX-Math.cos(pa)*4*s,headY-Math.sin(pa)*4*s);
      ctx.lineTo(headX+Math.cos(pa)*4*s,headY+Math.sin(pa)*4*s);
      ctx.stroke();

      ctx.beginPath(); ctx.arc(hdX,hdY,hdR,0,7);
      ctx.fillStyle='#E3B48C'; ctx.fill();
      ctx.beginPath(); ctx.arc(hdX,hdY,hdR,Math.PI*0.92,Math.PI*1.98);
      ctx.lineWidth=3.2*s; ctx.strokeStyle='#102618'; ctx.stroke();
      ctx.beginPath(); ctx.moveTo(hdX-hdR*1.6,hdY-hdR*0.22); ctx.lineTo(hdX+hdR*0.1,hdY-hdR*0.3);
      ctx.lineWidth=2.4*s; ctx.strokeStyle='#102618'; ctx.stroke();
    }

    function drawGrassFlecks(){
      for(var i=grassFlecks.length-1;i>=0;i--){
        var p=grassFlecks[i];
        p.x+=p.vx; p.y+=p.vy; p.vy+=0.12; p.life--;
        if(p.life<=0){ grassFlecks.splice(i,1); continue; }
        ctx.globalAlpha=Math.min(p.life/14,1);
        ctx.fillStyle='#3d8a55';
        ctx.fillRect(p.x-1,p.y-2,2,4);
        ctx.globalAlpha=1;
      }
    }

    function updateSwing(){
      if(swing.phase==='strike'){
        swing.a+=0.16;
        if(swing.a>=0&&!swing.fired){
          swing.fired=true;
          if(pending){
            ball.vx=pending.vx; ball.vy=pending.vy; ball.moving=true; pending=null;
            for(var gf=0;gf<7;gf++){
              grassFlecks.push({x:ball.x+(Math.random()-.5)*8,y:ball.y+(Math.random()-.5)*4,
                vx:(Math.random()-.5)*2.2,vy:-Math.random()*2.6-.6,life:22+Math.random()*10});
            }
          }
          sndPutt(); buzz(20); minDist=1e9;
        }
        if(swing.a>=0.55) swing.phase='follow';
      }else if(swing.phase==='follow'){
        swing.a*=0.88;
        if(Math.abs(swing.a)<0.02){ swing.a=0; swing.phase='idle'; }
      }
    }

    function drawTrail(){
      for(var i=0;i<trail.length;i++){
        var p=trail[i], s=ps(p.y), a=(i/trail.length)*0.22;
        ctx.beginPath(); ctx.arc(tx(p.x,p.y),p.y,ball.r*s*0.55,0,7);
        ctx.fillStyle='rgba(255,255,255,'+a.toFixed(2)+')'; ctx.fill();
      }
    }

    function drawBall(){
      if(ball.scale<=0) return;
      var s=ps(ball.y), r=ball.r*s*ball.scale;
      var px=tx(ball.x,ball.y), py=ball.y;
      ctx.beginPath(); ctx.ellipse(px,py+r*0.88,r*1.15,r*0.42,0,0,7);
      ctx.fillStyle='rgba(0,0,0,.14)'; ctx.fill();
      ctx.beginPath(); ctx.ellipse(px,py+r*0.85,r*0.9,r*0.32,0,0,7);
      ctx.fillStyle='rgba(0,0,0,.24)'; ctx.fill();
      var bg=ctx.createRadialGradient(px-r*0.35,py-r*0.42,r*0.18,px,py,r);
      bg.addColorStop(0,'#fff'); bg.addColorStop(.62,'#F0EEE8'); bg.addColorStop(1,'#AFA99C');
      ctx.beginPath(); ctx.arc(px,py,r,0,7);
      ctx.fillStyle=bg; ctx.fill();
      ctx.save();
      ctx.translate(px,py); ctx.rotate(ball.roll);
      ctx.fillStyle='rgba(0,0,0,.11)';
      var dps=[[-.3,-.2],[.25,-.35],[.05,.1],[-.25,.3],[.35,.22],[0,-.02]];
      for(var i=0;i<dps.length;i++){
        ctx.beginPath(); ctx.arc(dps[i][0]*r,dps[i][1]*r,r*0.12,0,7); ctx.fill();
      }
      ctx.restore();
      ctx.beginPath(); ctx.arc(px-r*0.3,py-r*0.36,r*0.2,0,7);
      ctx.fillStyle='rgba(255,255,255,.9)'; ctx.fill();
    }

    function drawTutorial(){
      if(hasPutted||aiming||ball.moving||swing.phase!=='idle') return;
      var s=ps(ball.y), px=tx(ball.x,ball.y), py=ball.y;
      var pulse=reduced?0.6:0.35+(Math.sin(t*0.08)+1)*0.25;
      var off=reduced?22:14+(Math.sin(t*0.08)+1)*7;
      ctx.save(); ctx.globalAlpha=pulse;
      ctx.beginPath(); ctx.arc(px,py,ball.r*s+6,0,7);
      ctx.strokeStyle='#fff'; ctx.lineWidth=1.6; ctx.setLineDash([4,5]); ctx.stroke();
      ctx.setLineDash([]);
      ctx.strokeStyle='#fff'; ctx.lineWidth=2.2; ctx.lineCap='round'; ctx.lineJoin='round';
      ctx.beginPath();
      ctx.moveTo(px,py+14); ctx.lineTo(px,py+off+16);
      ctx.moveTo(px-5,py+off+11); ctx.lineTo(px,py+off+16); ctx.lineTo(px+5,py+off+11);
      ctx.stroke();
      ctx.restore();
    }

    function drawAim(){
      var dx=ball.x-aimX, dy=ball.y-aimY;
      var hyp=Math.hypot(dx,dy);
      var len=Math.min(hyp,130);
      if(len<10) return;
      var nx=dx/hyp, ny=dy/hyp;
      var p=len/130;
      var col=p<0.55?'#C9A84C':(p<0.85?'#D98E4A':'#D96B4A');
      var dots=Math.floor(len/13);
      for(var i=1;i<=dots;i++){
        var lx=ball.x+nx*i*16, ly=ball.y+ny*i*16, s=ps(ly);
        ctx.beginPath(); ctx.arc(tx(lx,ly),ly,(3.2-(i/dots)*1.6)*s,0,7);
        ctx.fillStyle='rgba(255,255,255,'+(0.85-(i/dots)*0.55).toFixed(2)+')';
        ctx.fill();
      }
      var bs=ps(ball.y), bx=tx(ball.x,ball.y);
      ctx.beginPath(); ctx.arc(bx,ball.y,16*bs,-Math.PI/2,-Math.PI/2+p*Math.PI*2);
      ctx.strokeStyle=col; ctx.lineWidth=3.5; ctx.lineCap='round'; ctx.stroke();
      ctx.beginPath(); ctx.moveTo(bx,ball.y); ctx.lineTo(tx(aimX,aimY),aimY);
      ctx.strokeStyle='rgba(255,255,255,.18)'; ctx.lineWidth=1.2; ctx.stroke();
    }

    function spawnConfetti(){
      if(reduced) return;
      var cols=['#C9A84C','#F8F6F1','#2E7D4F','#E8D9A8'];
      var hx=tx(hole.x,hole.y);
      for(var i=0;i<80;i++){
        particles.push({
          x:hx,y:hole.y,
          vx:(Math.random()-0.5)*7.5,
          vy:-Math.random()*6.5-2,
          rot:Math.random()*6.3,vr:(Math.random()-0.5)*0.3,
          s:Math.random()*5+3,
          col:cols[i%cols.length],
          life:Math.random()*40+55
        });
      }
    }
    function drawParticles(){
      for(var i=particles.length-1;i>=0;i--){
        var p=particles[i];
        p.x+=p.vx; p.y+=p.vy; p.vy+=0.18; p.rot+=p.vr; p.life--;
        if(p.life<=0){ particles.splice(i,1); continue; }
        ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot);
        ctx.globalAlpha=Math.min(p.life/30,1);
        ctx.fillStyle=p.col; ctx.fillRect(-p.s/2,-p.s/2,p.s,p.s*0.6);
        ctx.restore();
      }
      ctx.globalAlpha=1;
    }

    function setMsg(s){ if(msgEl) msgEl.textContent=s; }
    function markTry(){
      if(!triesEl) return;
      var dots=triesEl.querySelectorAll('i');
      for(var i=0;i<dots.length;i++) dots[i].classList.toggle('used',i>=tries);
    }

    function finish(won){
      finished=true;
      setTimeout(function(){
        var title=document.getElementById('agp-result-title');
        var sub=document.getElementById('agp-result-sub');
        if(won){
          if(title) title.textContent='¡Putt perfecto!';
          if(sub) sub.textContent='Te lo ganaste. Deja tu correo y desbloquea tu 15% de descuento.';
        }else{
          if(title) title.textContent='El golf es así…';
          if(sub) sub.textContent='Igual te ganaste el 15% por intentarlo. Deja tu correo y desbloquéalo.';
        }
        showView('email');
        var inp=views.email.querySelector('input[type="email"]');
        if(inp) setTimeout(function(){ inp.focus(); },150);
      },won?1100:650);
    }

    function physics(){
      if(!ball.moving||ball.sinking) return;
      for(var s=0;s<2;s++){
        ball.x+=ball.vx/2; ball.y+=ball.vy/2;
        var minX=GX+ball.r+2,maxX=GX+GW-ball.r-2,minY=GY+ball.r+4,maxY=GY+GH-ball.r-2;
        var hit=false;
        if(ball.x<minX){ball.x=minX;ball.vx=-ball.vx*0.5;hit=true;}
        if(ball.x>maxX){ball.x=maxX;ball.vx=-ball.vx*0.5;hit=true;}
        if(ball.y<minY){ball.y=minY;ball.vy=-ball.vy*0.5;hit=true;}
        if(ball.y>maxY){ball.y=maxY;ball.vy=-ball.vy*0.5;hit=true;}
        if(hit&&Math.hypot(ball.vx,ball.vy)>1.2){ shake=4; sndBounce(); }
        var dx=ball.x-hole.x,dy=ball.y-hole.y,dist=Math.hypot(dx,dy);
        if(dist<minDist) minDist=dist;
        var speed=Math.hypot(ball.vx,ball.vy);
        if(dist<hole.r-2&&speed<3.2){ sink(); return; }
        if(dist<hole.r+2&&speed>=3.2&&!lipped){
          lipped=true; shake=3;
          var ang=Math.atan2(ball.vy,ball.vx)+(dx*ball.vy-dy*ball.vx>0?0.5:-0.5);
          speed*=0.74;
          ball.vx=Math.cos(ang)*speed; ball.vy=Math.sin(ang)*speed;
        }
        if(dist>32) lipped=false;
      }
      var sp=Math.hypot(ball.vx,ball.vy);
      if(sp>0.6) ball.vx+=0.0085*breakDir; /* solo a velocidad alta: si no, el break equilibra la fricción y la pelota nunca se detiene */
      ball.vx*=0.975; ball.vy*=0.975;
      ball.roll+=sp/9*(ball.vx>=0?1:-1)*0.5;
      trail.push({x:ball.x,y:ball.y});
      if(trail.length>11) trail.shift();
      if(Math.hypot(ball.vx,ball.vy)<0.18){
        ball.moving=false; ball.vx=0; ball.vy=0;
        endY=ball.y; trail=[];
        miss();
      }
    }

    function sink(){
      ball.sinking=true; ball.moving=false; trail=[];
      ball.x=hole.x; ball.y=hole.y;
      sndSink(); buzz([15,40,70]);
      var iv=setInterval(function(){
        ball.scale-=0.12;
        if(ball.scale<=0){ ball.scale=0; clearInterval(iv); spawnConfetti(); setMsg('¡Dentro!'); finish(true); }
      },28);
    }

    function missMsg(){
      if(minDist<24) return '¡Por centímetros!';
      if(endY>hole.y+60&&minDist>40) return 'Te quedaste corto';
      if(endY<hole.y-20) return 'Muy fuerte';
      return 'Casi…';
    }

    function miss(){
      if(finished||ball.sinking) return;
      tries--; markTry();
      if(tries>0){
        setMsg(missMsg()+' · Intento '+(4-tries)+' de 3');
        setTimeout(function(){
          ball.x=start.x; ball.y=start.y; ball.scale=1; lipped=false; minDist=1e9;
        },650);
      }else{
        setMsg(missMsg()+' · Se acabaron los intentos');
        finish(false);
      }
    }

    function localPos(e){
      var r=canvas.getBoundingClientRect();
      var cx=(e.touches?e.touches[0].clientX:e.clientX)-r.left;
      var cy=(e.touches?e.touches[0].clientY:e.clientY)-r.top;
      return {x:cx*(W/r.width),y:cy*(H/r.height)};
    }
    canvas.addEventListener('pointerdown',function(e){
      audio();
      if(ball.moving||ball.sinking||finished||swing.phase!=='idle') return;
      var p=localPos(e);
      if(Math.hypot(p.x-tx(ball.x,ball.y),p.y-ball.y)<55){
        aiming=true; aimX=p.x; aimY=p.y;
        try{ canvas.setPointerCapture(e.pointerId); }catch(err){}
      }
    });
    canvas.addEventListener('pointermove',function(e){
      if(!aiming) return;
      var p=localPos(e); aimX=p.x; aimY=p.y;
    });
    canvas.addEventListener('pointerup',function(){
      if(!aiming) return;
      var pw=power();
      aiming=false;
      var dx=ball.x-aimX, dy=ball.y-aimY;
      var hyp=Math.hypot(dx,dy);
      var len=Math.min(hyp,130);
      if(len<12) return;
      pending={vx:(dx/hyp)*len*0.105, vy:(dy/hyp)*len*0.105};
      swing.phase='strike'; swing.a=-pw*1.05; swing.fired=false;
      hasPutted=true;
    });

    /* física por tiempo real (16,7 ms por paso): idéntica a 60 fps, en pestañas
       estranguladas o pantallas de 120 Hz. Máx 6 pasos de recuperación por frame. */
    var lastT=performance.now();
    (function loop(){
      var now=performance.now();
      var n=Math.min(Math.max(Math.round((now-lastT)/16.7),1),6);
      lastT=now;
      for(var i2=0;i2<n;i2++){ t++; updateSwing(); physics(); if(introT<introDur) introT++; }
      ctx.clearRect(0,0,W,H);
      ctx.save();
      var introK = introT<introDur ? (1-introT/introDur) : 0;
      if(shake>0.4&&!reduced){
        ctx.translate((Math.random()-0.5)*shake,(Math.random()-0.5)*shake);
        shake*=0.82;
      }else shake=0;
      if(introK>0){
        var iSc=1+introK*0.06;
        ctx.translate(W/2,H/2); ctx.scale(iSc,iSc); ctx.translate(-W/2,-H/2-introK*10);
      }
      drawSky();
      drawGreen();
      drawHole();
      drawBreak();
      drawFlag();
      drawGolfer();
      drawTrail();
      if(aiming) drawAim();
      drawTutorial();
      drawGrassFlecks();
      drawBall();
      drawParticles();
      ctx.restore();
      requestAnimationFrame(loop);
    })();
  }
})();
</script>
